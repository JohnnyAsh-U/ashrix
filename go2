    }

    if err := b.db.Create(dbConfig).Error; err != nil {
        return fmt.Errorf("failed to save provider config: %w", err)
    }

    // Create adapter
    adapter, err := b.createAdapter(cfg)
    if err != nil {
        return fmt.Errorf("failed to create adapter: %w", err)
    }

    b.adapters[cfg.Name] = adapter
    return nil
}

