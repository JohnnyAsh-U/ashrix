type ProviderConfig struct {
    ID           uint           `gorm:"primaryKey"`
    Name         string         `gorm:"uniqueIndex;not null"`
    Type         string         `gorm:"not null"` // google, microsoft, okta, oidc, saml
    ClientID     string         `gorm:"not null"`
    ClientSecret string         `gorm:"not null"`
    RedirectURL  string         `gorm:"not null"`
    IssuerURL    string
    Tenant       string
    OktaDomain   string
    MetadataURL  string
    PrivateKey   string         `gorm:"type:text"`
    Certificate  string         `gorm:"type:text"`
    Extra        string         `gorm:"type:jsonb"` // JSON for additional configs
    IsActive     bool           `gorm:"default:true"`
    CreatedAt    time.Time
    UpdatedAt    time.Time
