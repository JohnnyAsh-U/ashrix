    "github.com/yourusername/gateway/internal/store/postgres"
    "github.com/yourusername/gateway/internal/store/postgres/generated"
)

type CPHandler struct {
    store          *postgres.Store
    adapterFactory *oidc.Factory
}

func NewCPHandler(store *postgres.Store, adapterFactory *oidc.Factory) *CPHandler {
    return &CPHandler{
        store:          store,
        adapterFactory: adapterFactory,
    }
}

func (h *CPHandler) CreateOrganization(w http.ResponseWriter, r *http.Request) {
    var input struct {
        Name string `json:"name"`
        Slug string `json:"slug"`
    }

    if err := json.NewDecoder(r.Body).Decode(&input); err != nil {
        http.Error(w, "Invalid request body", http.StatusBadRequest)
        return
    }

    org, err := h.store.CreateOrganization(r.Context(), generated.CreateOrganizationParams{
        Name: input.Name,
        Slug: input.Slug,
    })
    if err != nil {
        http.Error(w, "Failed to create organization", http.StatusInternalServerError)
        return
    }

    w.WriteHeader(http.StatusCreated)
    json.NewEncoder(w).Encode(org)
}

func (h *CPHandler) GetOrganization(w http.ResponseWriter, r *http.Request) {
    orgID := chi.URLParam(r, "orgID")
    id, err := uuid.Parse(orgID)
    if err != nil {
        http.Error(w, "Invalid organization ID", http.StatusBadRequest)
        return
    }

    org, err := h.store.GetOrganization(r.Context(), id)
    if err != nil {
        http.Error(w, "Organization not found", http.StatusNotFound)
        return
    }

    json.NewEncoder(w).Encode(org)
}

func (h *CPHandler) ConfigureIdP(w http.ResponseWriter, r *http.Request) {
    orgID := chi.URLParam(r, "orgID")
    id, err := uuid.Parse(orgID)
    if err != nil {
        http.Error(w, "Invalid organization ID", http.StatusBadRequest)
        return
    }

    var input struct {
        ProviderType string                 `json:"provider_type"`
        BaseConfig   generated.BaseConfig   `json:"base_config"`
        ExtraConfig  map[string]interface{} `json:"extra_config"`
    }

    if err := json.NewDecoder(r.Body).Decode(&input); err != nil {
        http.Error(w, "Invalid request body", http.StatusBadRequest)
        return
    }

    // Validate config with adapter
    adapterCfg := oidc.IdPConfig{
        OrgID:        orgID,
        ProviderType: input.ProviderType,
        BaseConfig: oidc.BaseConfig{
            ClientID:     input.BaseConfig.ClientID,
            ClientSecret: input.BaseConfig.ClientSecret,
            IssuerURL:    input.BaseConfig.IssuerURL,
            Scopes:       input.BaseConfig.Scopes,
            RedirectURI:  input.BaseConfig.RedirectURI,
        },
        ExtraConfig: input.ExtraConfig,
    }

    adapter, err := h.adapterFactory.CreateAdapter(adapterCfg)
    if err != nil {
        http.Error(w, "Invalid IdP configuration: "+err.Error(), http.StatusBadRequest)
        return
    }

    if err := adapter.ValidateConfig(r.Context()); err != nil {
        http.Error(w, "Failed to validate IdP configuration: "+err.Error(), http.StatusBadRequest)
        return
    }

    idpConfig, err := h.store.CreateIdPConfig(r.Context(), generated.CreateIdPConfigParams{
        OrgID:        id,
        ProviderType: input.ProviderType,
        BaseConfig:   input.BaseConfig,
        ExtraConfig:  input.ExtraConfig,
    })
    if err != nil {
        http.Error(w, "Failed to save IdP configuration", http.StatusInternalServerError)
        return
    }

    w.WriteHeader(http.StatusCreated)
    json.NewEncoder(w).Encode(idpConfig)
}

func (h *CPHandler) CreatePolicy(w http.ResponseWriter, r *http.Request) {
    var input struct {
        OrgID           string                   `json:"org_id"`
        AppID           *string                  `json:"app_id,omitempty"`
        Name            string                   `json:"name"`
        Description     string                   `json:"description,omitempty"`
        Priority        int                      `json:"priority"`
        Effect          string                   `json:"effect"`
        ResourcePath    string                   `json:"resource_path,omitempty"`
        ResourceMethods []string                 `json:"resource_methods"`
        Conditions      []generated.Condition    `json:"conditions"`
    }

    if err := json.NewDecoder(r.Body).Decode(&input); err != nil {
        http.Error(w, "Invalid request body", http.StatusBadRequest)
        return
    }

    orgID, err := uuid.Parse(input.OrgID)
    if err != nil {
        http.Error(w, "Invalid organization ID", http.StatusBadRequest)
        return
    }

    params := generated.CreatePolicyParams{
        OrgID:           orgID,
        Name:            input.Name,
        Description:     input.Description,
        Priority:        int32(input.Priority),
        Effect:          input.Effect,
        ResourcePath:    input.ResourcePath,
        ResourceMethods: input.ResourceMethods,
        Conditions:      input.Conditions,
    }

    if input.AppID != nil {
        appID, err := uuid.Parse(*input.AppID)
        if err != nil {
            http.Error(w, "Invalid application ID", http.StatusBadRequest)
            return
        }
        params.AppID = uuid.NullUUID{UUID: appID, Valid: true}
    }

    policy, err := h.store.CreatePolicy(r.Context(), params)
    if err != nil {
        http.Error(w, "Failed to create policy", http.StatusInternalServerError)
        return
    }

    w.WriteHeader(http.StatusCreated)
    json.NewEncoder(w).Encode(policy)
}

func (h *CPHandler) SearchUsers(w http.ResponseWriter, r *http.Request) {
    orgID := chi.URLParam(r, "orgID")
    query := r.URL.Query().Get("q")
    limitStr := r.URL.Query().Get("limit")
    limit := 20
    if limitStr != "" {
        limit, _ = strconv.Atoi(limitStr)
    }

    id, err := uuid.Parse(orgID)
    if err != nil {
        http.Error(w, "Invalid organization ID", http.StatusBadRequest)
        return
    }

    config, err := h.store.GetIdPConfig(r.Context(), id)
    if err != nil {
        http.Error(w, "IdP not configured", http.StatusNotFound)
        return
    }

    adapter, err := h.adapterFactory.CreateAdapter(oidc.IdPConfig{
        ID:           config.ID.String(),
        OrgID:        orgID,
        ProviderType: config.ProviderType,
        BaseConfig:   config.BaseConfig,
        ExtraConfig:  config.ExtraConfig,
    })
    if err != nil {
        http.Error(w, "Failed to initialize IdP", http.StatusInternalServerError)
        return
    }

    users, err := adapter.SearchUsers(r.Context(), query, limit)
    if err != nil {
        http.Error(w, "Search failed: "+err.Error(), http.StatusInternalServerError)
        return
    }

    json.NewEncoder(w).Encode(users)
}

