package cp

import (
    "encoding/base64"
    "encoding/json"
    "fmt"
    "net/http"
    "time"

    "github.com/google/uuid"
    "github.com/yourusername/gateway/internal/auth/oidc"
)

type OAuthHandler struct {
    store          *postgres.Store
    adapterFactory *oidc.Factory
    sessionStore   SessionStore
}

type SessionStore interface {
    Create(state string, data OAuthState) error
    Get(state string) (*OAuthState, error)
    Delete(state string) error
}

type OAuthState struct {
    OrgID        string    `json:"org_id"`
    AppID        string    `json:"app_id"`
    RedirectURL  string    `json:"redirect_url"`
    CreatedAt    time.Time `json:"created_at"`
}

func NewOAuthHandler(store *postgres.Store, adapterFactory *oidc.Factory, sessionStore SessionStore) *OAuthHandler {
    return &OAuthHandler{
        store:          store,
        adapterFactory: adapterFactory,
        sessionStore:   sessionStore,
    }
}

func (h *OAuthHandler) Login(w http.ResponseWriter, r *http.Request) {
    orgSlug := r.URL.Query().Get("org")
    redirectURL := r.URL.Query().Get("redirect")

    org, err := h.store.GetOrganizationBySlug(r.Context(), orgSlug)
    if err != nil {
        http.Error(w, "Organization not found", http.StatusNotFound)
        return
    }

    idpConfig, err := h.store.GetIdPConfig(r.Context(), org.ID)
    if err != nil {
        http.Error(w, "IdP not configured", http.StatusNotFound)
        return
    }

    adapter, err := h.adapterFactory.CreateAdapter(oidc.IdPConfig{
        ID:           idpConfig.ID.String(),
        OrgID:        org.ID.String(),
        ProviderType: idpConfig.ProviderType,
        BaseConfig:   idpConfig.BaseConfig,
        ExtraConfig:  idpConfig.ExtraConfig,
    })
    if err != nil {
        http.Error(w, "Failed to initialize IdP", http.StatusInternalServerError)
        return
    }

    // Generate state with CSRF protection
    stateBytes := make([]byte, 32)
    if _, err := rand.Read(stateBytes); err != nil {
        http.Error(w, "Internal error", http.StatusInternalServerError)
        return
    }
    state := base64.URLEncoding.EncodeToString(stateBytes)

    // Save state
    oauthState := OAuthState{
        OrgID:       org.ID.String(),
        RedirectURL: redirectURL,
        CreatedAt:   time.Now(),
    }
    if err := h.sessionStore.Create(state, oauthState); err != nil {
        http.Error(w, "Internal error", http.StatusInternalServerError)
        return
    }

    oauth2Config := adapter.GetOAuth2Config()
    authURL := oauth2Config.AuthCodeURL(state)

    http.Redirect(w, r, authURL, http.StatusFound)
}

func (h *OAuthHandler) Callback(w http.ResponseWriter, r *http.Request) {
    state := r.URL.Query().Get("state")
    code := r.URL.Query().Get("code")

    if state == "" || code == "" {
        http.Error(w, "Missing parameters", http.StatusBadRequest)
        return
    }

    // Get saved state
    oauthState, err := h.sessionStore.Get(state)
    if err != nil {
        http.Error(w, "Invalid state", http.StatusBadRequest)
        return
    }
    defer h.sessionStore.Delete(state)

    // Check state age
    if time.Since(oauthState.CreatedAt) > 10*time.Minute {
        http.Error(w, "State expired", http.StatusBadRequest)
        return
    }

    orgID, _ := uuid.Parse(oauthState.OrgID)
    idpConfig, err := h.store.GetIdPConfig(r.Context(), orgID)
    if err != nil {
        http.Error(w, "IdP not found", http.StatusNotFound)
        return
    }

    adapter, err := h.adapterFactory.CreateAdapter(oidc.IdPConfig{
        ID:           idpConfig.ID.String(),
        OrgID:        oauthState.OrgID,
        ProviderType: idpConfig.ProviderType,
        BaseConfig:   idpConfig.BaseConfig,
        ExtraConfig:  idpConfig.ExtraConfig,
    })
    if err != nil {
        http.Error(w, "Failed to initialize IdP", http.StatusInternalServerError)
        return
    }

    // Exchange code for token
    token, err := adapter.ExchangeCode(r.Context(), code)
    if err != nil {
        http.Error(w, "Authentication failed", http.StatusUnauthorized)
        return
    }

    // Set session cookie
    http.SetCookie(w, &http.Cookie{
        Name:     "access_token",
        Value:    token.AccessToken,
        HttpOnly: true,
        Secure:   r.TLS != nil,
        SameSite: http.SameSiteLaxMode,
        Path:     "/",
        MaxAge:   int(token.Expiry.Sub(time.Now()).Seconds()),
    })

    // Redirect back to original URL
    redirectURL := oauthState.RedirectURL
    if redirectURL == "" {
        redirectURL = "/"
    }
    http.Redirect(w, r, redirectURL, http.StatusFound)
}